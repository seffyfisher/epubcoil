---
import BaseLayout from '../../layouts/BaseLayout.astro';
const groups = [
  ['חבילה (OPF)', [['הגדירו <code>dc:language</code> ל־<code>he</code>.', 'זו שפת הפרסום, ולא תחליף לשפה בכל מסמך.', '/hebrew/rtl-basics/'], ['הגדירו ב־<code>spine</code> את <code>page-progression-direction="rtl"</code>.', 'הוא מבהיר לקורא את כיוון הדפדוף הכללי.', '/glossary/page-progression-direction/'], ['רשמו כל XHTML, CSS, גופן ותמונה ב־manifest.', 'משאבים שאינם ב־manifest אינם חלק תקין מן החבילה.', '/basics/epub-file-structure/'], ['בדקו שסדר ה־<code>itemref</code> ב־spine הוא סדר הקריאה.', 'כיוון RTL אינו הופך את סדר הפרקים.', '/glossary/spine/'], ['הוסיפו מסמך nav ל־EPUB 3 או NCX ל־EPUB 2.', 'תוכן עניינים תקין מסייע לניווט בקוראים.', '/glossary/nav-document/']]],
  ['מסמכי תוכן', [['הגדירו בשורש XHTML את <code>lang="he"</code>, <code>xml:lang="he"</code> ו־<code>dir="rtl"</code>.', 'השפה והכיוון שייכים למבנה המסמך.', '/hebrew/rtl-basics/'], ['לפרק או לציטוט משמעותי באנגלית הגדירו <code>lang="en" dir="ltr"</code>.', 'כך קטע לטיני אינו תלוי בניחוש bidi.', '/hebrew/rtl-basics/'], ['השתמשו ב־<code>bdi dir="auto"</code> לתוכן שכיוונו אינו ידוע מראש.', 'הוא מבודד מזהים, כתובות ורצפים מעורבים.', '/hebrew/rtl-basics/'], ['השתמשו ב־<code>bdo</code> רק כשבאמת צריך לכפות כיוון.', 'כפיית כיוון אינה תיקון כללי למספרים.', '/hebrew/rtl-basics/'], ['סמנו כותרות, פסקאות, רשימות וציטוטים ב־HTML סמנטי.', 'הסמנטיקה נשמרת גם כשהקורא מחליף עיצוב.', '/css/css-in-epub/']]],
  ['CSS', [['אל תשתמשו ב־<code>direction</code> או <code>unicode-bidi</code> ב־CSS.', 'EPUB 3.3 §6.3.1.2 אוסר אותם; כיוון נקבע ב־HTML.', '/hebrew/rtl-basics/'], ['העדיפו <code>text-align: start</code> על <code>right</code>.', 'היישור נשאר הגיוני גם במקטע LTR.', '/css/css-in-epub/'], ['השתמשו במאפיינים לוגיים כגון <code>margin-inline-start</code>.', 'הם מתארים התחלה וסוף במקום צד פיזי.', '/css/css-in-epub/'], ['הימנעו מ־<code>position: fixed</code>, מיקום מוחלט וגובה קבוע בתוכן זורם.', 'הם נשברים אחרי שינוי גופן או מסך.', '/css/css-in-epub/'], ['השתמשו ביחידות יחסיות לטקסט ולרווחים.', 'הקורא יכול לשנות גודל גופן ושוליים.', '/css/css-in-epub/'], ['הוסיפו <code>break-before: page</code> לצד <code>page-break-before</code> כשצריך.', 'לקוראים ישנים נדרש לעתים השם הוותיק.', '/css/css-in-epub/']]],
  ['גופנים', [['כללו גופנים בתוך ה־EPUB והפנו אליהם בנתיב יחסי.', 'קישור חיצוני אינו בסיס אמין לספר ללא רשת.', '/css/css-in-epub/'], ['רשמו קובצי גופן ב־manifest.', 'רק כך הם חלק מחבילת הפרסום.', '/css/css-in-epub/'], ['בדקו שלגופן יש עברית, ניקוד והסימנים הדרושים.', 'חסר גליף בולט במיוחד בניקוד.', '/css/css-in-epub/'], ['בדקו רישיון הפצה והטמיעו רק משקלים נדרשים.', 'רישיון וגודל החבילה הם חלק מההפקה.', '/css/css-in-epub/'], ['הגדירו fallback סביר ואל תכפו גופן עם <code>!important</code>.', 'מערכת הקריאה רשאית לכבד העדפת קורא.', '/css/css-in-epub/']]],
  ['ניקוד וטיפוגרפיה', [['בדקו ניקוד, גרשיים, מקף, סוגריים ופיסוק בגופן שנבחר.', 'כאן כיסוי הגליפים וה־bidi נחשפים.', '/hebrew/rtl-basics/'], ['בדקו מספרים, ISBN, מחירים, תאריכים וכתובות URL במשפט עברי.', 'הקשר דו־כיווני עשוי לשנות את התצוגה.', '/hebrew/rtl-basics/'], ['אל תפתרו בעיות bidi בתווי כיוון בלתי נראים בלי להבין את הסיבה.', 'הם מקשים על עריכה ואבחון.', '/hebrew/rtl-basics/'], ['אל תשתמשו ב־<code>writing-mode</code> כפתרון לעברית אופקית.', 'עברית רגילה אינה זקוקה לו.', '/hebrew/rtl-basics/']]],
  ['תמונות וטבלאות', [['לתמונה בעלת מידע כתבו <code>alt</code>; לתמונה דקורטיבית <code>alt=""</code>.', 'טקסט חלופי הוא חלק מהנגישות.', '/css/css-in-epub/'], ['הגבילו תמונות ל־<code>max-inline-size: 100%</code> והשאירו גובה יחסי.', 'כך הן אינן חורגות מאזור הקריאה.', '/css/css-in-epub/'], ['בדקו טבלאות ותרשימים במסך צר ובגופן מוגדל.', 'ספר זורם אינו מבטיח רוחב קבוע.', null], ['בדקו כיתובים ותמונות עם טקסט RTL ו־LTR מעורב.', 'כיתוב הוא נקודת bidi שכיחה.', '/hebrew/rtl-basics/']]],
  ['נגישות', [['השתמשו בכותרות לפי היררכיה ולא רק לצורך גודל.', 'קוראי מסך וניווט מסתמכים על המבנה.', null], ['כתבו קישורים בעלי שם מובן בהקשר.', '״לחצו כאן״ אינו מתאר יעד לקורא מסך.', null], ['הוסיפו מטא־דאטה כגון <code>schema:accessMode</code>, <code>schema:accessibilityFeature</code> ו־<code>schema:accessibilitySummary</code>.', 'הוא מתאר לקוראים מה הספר כולל.', null], ['ודאו שתוכן אינו תלוי בצבע בלבד.', 'ניגוד ומשמעות טקסטואלית עוזרים לקוראים שונים.', null], ['בדקו את ה־EPUB גם בכלי ולידציה.', 'בדיקה מבנית אינה מחליפה קריאה אמיתית.', '/glossary/epubcheck/']]],
  ['בדיקות במכשירים', [['פתחו את הספר לפחות בשתי מערכות קריאה.', 'התמיכה ב־CSS וב־RTL משתנה בין קוראים.', '/hebrew/rtl-basics/'], ['בדקו גודל גופן קטן וגדול, נושא בהיר וכהה אם זמין.', 'העדפות קורא חושפות הנחות עיצוב.', '/css/css-in-epub/'], ['עברו קדימה ואחורה בתחילת הספר, בסופו ובפרק עם תוכן מעורב.', 'כך בודקים דפדוף, spine ו־bidi יחד.', '/hebrew/rtl-basics/'], ['בדקו תוכן עניינים, קישורים פנימיים, הערות שוליים ותמונות עם כיתוב.', 'אלה מסלולי ניווט ותצוגה רגישים.', '/glossary/nav-document/'], ['הריצו EPUBCheck לפני מסירה ותעדו בעיות לפי קורא ומכשיר.', 'EPUBCheck אינו מחליף בדיקה חזותית.', '/glossary/epubcheck/']]]
];
---
<BaseLayout title="צ׳קליסט RTL לספרי EPUB בעברית | epub.co.il" description="רשימת בדיקה מעשית לעברית ולכיווניות בספרי EPUB.">
  <section class="page-head"><p class="kicker">כלים</p><h1>צ׳קליסט RTL לספרי EPUB בעברית</h1><p class="lede">רשימת מסירה לעברית, כיווניות ונגישות. אפשר לסמן בדפדפן או להדפיס.</p></section>
  <section class="checklist-tools" aria-label="מצב הרשימה"><p data-progress>0 מתוך 0 הושלמו</p><button type="button" data-reset>איפוס</button></section>
  <ol class="rtl-checklist" data-checklist>{groups.map(([name, items]) => <li><h2>{name}</h2><ul>{items.map(([line, why, href]) => <li class="check-item"><label><input type="checkbox" /> <span set:html={line}></span></label><p>{why} {href && <a href={href}>להרחבה</a>}</p></li>)}</ul></li>)}</ol>
</BaseLayout>
<script>
  const storageKey = 'epubcoil.rtlChecklist.v1';
  const boxes = [...document.querySelectorAll('[data-checklist] input[type="checkbox"]')];
  const progress = document.querySelector('[data-progress]');
  const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
  boxes.forEach((box, index) => { box.checked = Boolean(saved[index]); box.addEventListener('change', save); });
  document.querySelector('[data-reset]')?.addEventListener('click', () => { boxes.forEach((box) => { box.checked = false; }); save(); });
  function save() { localStorage.setItem(storageKey, JSON.stringify(boxes.map((box) => box.checked))); const done = boxes.filter((box) => box.checked).length; if (progress) progress.textContent = `${done} מתוך ${boxes.length} הושלמו`; }
  save();
</script>
<style>
  .checklist-tools{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-inline-size:var(--measure);margin-block:2rem;padding-block:.75rem;border-block:1px solid var(--rule)}.checklist-tools p{margin:0}.checklist-tools button{padding-inline:1rem;border:1px solid var(--rule);background:transparent;color:inherit}.rtl-checklist{max-inline-size:var(--measure);padding:0;list-style:none}.rtl-checklist>li{border-block-start:1px solid var(--rule)}.rtl-checklist h2{margin-block:1.25rem}.rtl-checklist ul{padding:0;list-style:none}.check-item{padding-block:.8rem;border-block-end:1px solid var(--rule)}.check-item label{display:flex;gap:.65rem;align-items:flex-start;cursor:pointer}.check-item input{flex:0 0 auto;inline-size:1.25rem;block-size:1.25rem;margin-block-start:.3rem;accent-color:var(--accent)}.check-item p{margin:.25rem 0 0 1.9rem;color:var(--muted);font-size:.9rem}@media print{.masthead,.site-footer,.skip-link,.checklist-tools{display:none!important}main{padding:0!important}.check-item{break-inside:avoid}a{color:inherit}}
</style>
