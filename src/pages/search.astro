---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="חיפוש | epub.co.il" description="חיפוש באתר epub.co.il"
  ><section class="page-head">
    <p class="kicker">חיפוש</p><h1>חיפוש באתר</h1>
  </section><div id="search" class="prose" aria-live="polite">
    טוענים את החיפוש…
  </div><script is:inline>
    {
      `(async()=>{const root=document.querySelector('#search'),q=new URLSearchParams(location.search).get('q')||'';try{const m=await import('/pagefind/pagefind.js'),pf=await m.init();if(!q){root.textContent='הקלידו מילת חיפוש בשדה בדף הבית.';return}const r=await pf.search(q);if(!r.results.length){root.textContent='לא נמצאו תוצאות.';return}root.innerHTML='<ol class="entry-list"></ol>';for(const x of r.results){const d=await x.data();root.querySelector('ol').insertAdjacentHTML('beforeend','<li><h2><a href="'+d.url+'">'+d.meta.title+'</a></h2><p>'+d.excerpt+'</p></li>')}}catch(e){root.textContent='החיפוש זמין לאחר בניית האתר.'}})()`;
    }
  </script></BaseLayout
>
