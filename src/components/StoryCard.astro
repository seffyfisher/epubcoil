---
import { articlePath } from "../lib/links";
import { sectionMap } from "../lib/sections";

const { article } = Astro.props;
---

<article class="story">
  <p class="meta">{sectionMap[article.data.section]}</p>
  <h3><a href={articlePath(article)}>{article.data.title}</a></h3>
  <p>{article.data.answer}</p>
</article>
