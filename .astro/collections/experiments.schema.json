{
  "$ref": "#/definitions/experiments",
  "definitions": {
    "experiments": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checked": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "interactive",
              "fixed-layout",
              "audio-video",
              "scripted",
              "typography",
              "accessibility",
              "generative",
              "other"
            ]
          },
          "creator": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "url",
          "checked",
          "title",
          "description",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}