{
  "$ref": "#/definitions/articles",
  "definitions": {
    "articles": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 50,
          "maxLength": 220
        },
        "section": {
          "type": "string",
          "enum": [
            "basics",
            "reading",
            "hebrew",
            "production",
            "design",
            "css",
            "js",
            "experiments"
          ]
        },
        "order": {
          "type": "number",
          "default": 100
        },
        "answer": {
          "type": "string",
          "minLength": 20
        },
        "published": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "minLength": 3
              },
              "a": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$",
            "errorMessage": {
              "pattern": "related must look like \"section/slug\""
            }
          }
        },
        "howto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "text"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            }
          },
          "required": [
            "name",
            "steps"
          ],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "draft": {
          "type": "boolean"
        },
        "needsReview": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "featured": {
          "type": "boolean"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "section",
        "answer",
        "published",
        "updated",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}