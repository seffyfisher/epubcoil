{
  "$ref": "#/definitions/providers",
  "definitions": {
    "providers": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checked": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "production",
                "conversion",
                "design",
                "typesetting",
                "accessibility",
                "audiobooks",
                "distribution"
              ]
            }
          },
          "city": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "url",
          "checked",
          "name",
          "services",
          "description",
          "sourceUrl"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}