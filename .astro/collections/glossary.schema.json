            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "updated": {
          "anyOf": [
            {
              "type": "string",
