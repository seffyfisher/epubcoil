      "type": "object",
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "termEn": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 10
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
